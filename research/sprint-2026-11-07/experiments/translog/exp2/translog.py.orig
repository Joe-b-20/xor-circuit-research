"""Transition log (EXPERIMENTAL, 2026-11-07 sprint): every change of the chain's gate count
inside the low band, written by the engine itself.

Why.  The 30 s chain.json sampler sees a 30 s snapshot of a walk that leaves and re-enters the
88 level ~12 times per second (FINDINGS F11): 68 % of hops between distinct 88 plateaus show no
89 sample.  Nobody knows how many distinct 88 states (or plateaus) a chain enters per hour, how
long the 89 excursions are, or whether two chains' trails ever meet between samples.  This module
records the transitions themselves, at the engine's step resolution.

What is written (``<worker dir>/translog.jsonl``, one JSON object per line):

* ``{"k": "open", ...}``        once per engine start/resume: worker, knobs, campaign clock ``t``
                                and wall time ``w`` (so ``t`` pairs with the sampler's ``t``).
* ``{"k": "step", ...}``        an accepted proposal changed the gate count, and the old or the
                                new count is <= ``translog.band_gates``;
* ``{"k": "chain", ...}``       a chain began (start, restart, resume): the state was replaced
                                wholesale, whatever the gate counts.

Fields of step/chain rows: ``it`` engine step counter, ``t`` campaign clock (s), ``w`` wall
time (s since the epoch), ``p`` gates before, ``g`` gates after, ``d`` depth after, ``m`` move
name (chain rows: the chain source), ``c`` engine chain sequence number.  When ``g`` is
<= ``translog.id_gates`` the row also carries ``id``, a 16-hex-digit identity of the state
(blake2b-64 of the sorted non-input values, canonical under ``translog.rotate_bits``-bit
rotation of the input masks when that is set: 8 for AES MixColumns/InvMixColumns, whose rows are
invariant under byte rotation; checked at start), and, by ``translog.values``, ``v`` = the
sorted non-input values (what chain.json/sampler.py call ``chain_values``) so plateaus can be
catalogued offline.

Cost.  One attribute compare per step; a row costs a dict + json.dumps (~10 us) and, at an
entry into the identity band, the canonical hash (~60 us with rotation at 88 values).  At the
measured ~12 entries per second this is ~0.1 % of a 1,750 step/s worker.  Writes are buffered
and flushed from the engine's periodic check (every 64 steps) and at checkpoints.
"""
from __future__ import annotations

import hashlib
import json
import time
from pathlib import Path
from time import perf_counter

from ..config.schema import Knob, Section

KNOBS = Section("translog", "EXPERIMENTAL: in-engine log of gate-count transitions in the low "
                "band (sprint 2026-11-07, connectivity question).", {
    "enabled": Knob(False, "Write <worker dir>/translog.jsonl."),
    "band_gates": Knob(89, "Log a transition when the gate count before or after it is at most "
                       "this (89 on MixColumns: the 88+89 band).", min=0),
    "id_gates": Knob(88, "States with at most this many gates get an identity hash (and values, "
                     "by translog.values) in their row.", min=0),
    "values_gates": Knob(None, "Rows with at most this many gates also carry the state's values "
                         "(no identity): set it to band_gates to keep the 89 state right after "
                         "an exit from 88, whose 88 exit state is one of its 88-subsets. "
                         "null = id_gates.", kind=int, nullable=True, min=0),
    "rotate_bits": Knob(0, "Normalise identities modulo rotation of the input masks by this "
                         "many bits (8 = byte rotation for AES MixColumns/InvMixColumns; the "
                         "target rows must be invariant, checked at start). 0 = none.", min=0),
    "values": Knob("entry", "When a row carries the state's values: entry (every row with an "
                   "identity), new (first time an identity is seen by this engine), never.",
                   choices=("entry", "new", "never")),
    "file": Knob("translog.jsonl", "File name inside the worker directory."),
})


def _identity(values: list, n: int, rotate: int) -> str:
    """blake2b-64 (hex) of the sorted values, minimal over rotations of the input masks."""
    best = values
    if rotate:
        mask = (1 << n) - 1
        s = rotate
        while s < n:
            r = sorted(((v << s) | (v >> (n - s))) & mask for v in values)
            if r < best:
                best = r
            s += rotate
    return hashlib.blake2b(",".join(map(str, best)).encode(), digest_size=8).hexdigest()


class TransitionLog:
    """The engine's transition logger; ``None`` stands in for it when disabled."""

    @classmethod
    def from_settings(cls, settings, target, recorder, worker_id):
        try:
            cfg = settings.view("translog")
            enabled = cfg.enabled
        except (KeyError, AttributeError):          # partial schemas (tests)
            return None
        if not enabled:
            return None
        directory = getattr(recorder, "directory", None)
        if directory is None:
            return None
        return cls(Path(directory) / cfg.file, worker_id, target, recorder, cfg.band_gates,
                   cfg.id_gates, cfg.rotate_bits, cfg.values, cfg.values_gates)

    def __init__(self, path, worker_id, target, recorder, band_gates, id_gates, rotate_bits,
                 values_mode, values_gates=None):
        self.path = Path(path)
        self.worker_id = worker_id
        self.recorder = recorder
        self.band = band_gates
        self.id_gates = id_gates
        self.values_gates = id_gates if values_gates is None else values_gates
        self.n = target.n_inputs
        self.rotate = rotate_bits
        self.values_mode = values_mode
        self.g = None                       # gate count of the last state seen
        self.rows = 0
        self.entries = 0                    # rows with an identity
        self.seconds = 0.0                  # time spent in this module (rows only)
        self._seen: set | None = set() if values_mode == "new" else None
        if rotate_bits:
            rows = set(target.rows)
            mask = (1 << self.n) - 1
            s = rotate_bits
            ok = True
            while s < self.n and ok:
                ok = {((v << s) | (v >> (self.n - s))) & mask for v in rows} == rows
                s += rotate_bits
            if not ok:
                recorder.event("translog", status="rotation_disabled",
                               reason=f"target rows not invariant under {rotate_bits}-bit rotation")
                self.rotate = 0
        self._f = open(self.path, "a", buffering=1 << 16)
        self._write({"k": "open", "worker": worker_id, "t": recorder.now(), "w": time.time(),
                     "band_gates": band_gates, "id_gates": id_gates, "rotate_bits": self.rotate,
                     "values": values_mode, "values_gates": self.values_gates,
                     "n_inputs": self.n})

    # ------------------------------------------------------------------ hot path
    def transition(self, kind: str, it: int, g: int, d, move, chain_seq: int, state) -> None:
        """Record that the chain is now at ``g`` gates (called when it differs from the last
        value seen, or for every chain begin)."""
        p = self.g
        self.g = g
        if kind == "step" and g > self.band and (p is None or p > self.band):
            return
        t0 = perf_counter()
        row = {"k": kind, "it": it, "t": round(self.recorder.now(), 3),
               "w": round(time.time(), 3), "p": p, "g": g, "d": d, "m": move, "c": chain_seq}
        if g <= self.id_gates:
            values = sorted(state.key())
            ident = _identity(values, self.n, self.rotate)
            row["id"] = ident
            self.entries += 1
            mode = self.values_mode
            if mode == "entry":
                row["v"] = values
            elif mode == "new" and ident not in self._seen:
                self._seen.add(ident)
                row["v"] = values
        elif g <= self.values_gates and self.values_mode != "never":
            row["v"] = sorted(state.key())
        self._write(row)
        self.seconds += perf_counter() - t0

    def _write(self, row: dict) -> None:
        self._f.write(json.dumps(row, separators=(",", ":")) + "\n")
        self.rows += 1

    # ------------------------------------------------------------------ housekeeping
    def flush(self) -> None:
        self._f.flush()

    def close(self) -> None:
        if not self._f.closed:
            self._write({"k": "close", "t": self.recorder.now(), "w": time.time(),
                         "rows": self.rows, "entries": self.entries,
                         "seconds": round(self.seconds, 3)})
            self._f.close()

    def summary(self) -> dict:
        return {"rows": self.rows, "entries": self.entries, "seconds": round(self.seconds, 3)}
