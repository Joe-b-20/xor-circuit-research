+def _better(self, worker_key, exclude_keys=(), rng=None) -> dict | None:
+    """v9 prototype: a distinct pooled circuit at the best feasible point (real depth cap),
+    only when that point is strictly better than ``worker_key``; else None."""
+    if getattr(self, "mode", "off") == "off":
+        return None
+    self.refresh()
+    cap, limit = self.spec.get("depth_cap"), self.spec.get("gate_limit")
+    points = [p for p in self._points
+              if (cap is None or p["depth"] <= cap) and (limit is None or p["gates"] <= limit)]
+    if not points:
+        return None
+    kind = self.spec["objective"]
+    best = min(points, key=lambda p: objective_key(kind, p["gates"], p["depth"]))
+    if worker_key is not None and objective_key(kind, best["gates"], best["depth"]) >= tuple(worker_key):
+        return None
+    exclude = exclude_keys if isinstance(exclude_keys, (set, frozenset)) else set(exclude_keys)
+    entries = [e for e in best["entries"] if self._eligible(e)]
+    if rng is not None:
+        rng.shuffle(entries)
+    for entry in entries:
+        elite = self._load(entry, exclude)
+        if elite is not None:
+            self.stats["samples"] += 1
+            self._note(elite)
+            return elite
+    return None
+
+
+Pool.better = _better
+
+
 class NullPool(Pool):
     """No campaign (``xorflux quick``): nothing to sample."""
 
