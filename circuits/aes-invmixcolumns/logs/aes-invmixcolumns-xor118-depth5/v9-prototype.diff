+    # ---- v9 prototype: per-group watcher -----------------------------------------------------
+    @staticmethod
+    def _helpers(values, outputs) -> frozenset:
+        """Non-input, non-output values (inputs are the unit vectors)."""
+        return frozenset(v for v in values if v & (v - 1)) - outputs
+
+    @staticmethod
+    def _jd(a, b) -> float:
+        union = len(a | b)
+        return 1.0 - len(a & b) / union if union else 0.0
+
+    def _group_seeds(self, wids) -> list[frozenset]:
+        seeds, seen = [], set()
+        for wid in wids:
+            seed = self.specs[wid].get("seed") or {}
+            sha = seed.get("sha256")
+            if seed.get("kind") != "file" or sha in seen or sha not in self.plan.get("seeds", {}):
+                continue
+            seen.add(sha)
+            circuit = read_json(self.run_dir / self.plan["seeds"][sha]["snapshot"], {}) or {}
+            if circuit.get("gates") is not None:
+                n = self.targets[self.specs[wid]["target"]].n_inputs
+                seeds.append(frozenset(circuit_values(circuit, n)))
+        return seeds
+
+    def group_watch(self) -> None:
+        groups: dict[str, list[str]] = {}
+        for wid, spec in self.specs.items():
+            groups.setdefault(spec["group"], []).append(wid)
+        (self.run_dir / "watch").mkdir(exist_ok=True)
+        if not hasattr(self, "_seed_cache"):
+            self._seed_cache = {}
+        for group, wids in groups.items():
+            key = self.specs[wids[0]]["target"]
+            outputs = frozenset(r for r in self.targets[key].rows if r & (r - 1))
+            if group not in self._seed_cache:
+                self._seed_cache[group] = [self._helpers(s, outputs) for s in self._group_seeds(wids)]
+            seeds = self._seed_cache[group]
+            chains, bests, raw = {}, {}, {}
+            for wid in wids:
+                data = read_json(self.run_dir / "workers" / wid / "chain.json", {}) or {}
+                if data.get("chain_values") is not None:
+                    chains[wid] = self._helpers(data["chain_values"], outputs)
+                if data.get("best_values") is not None:
+                    bests[wid] = self._helpers(data["best_values"], outputs)
+                raw[wid] = data
+            rows = []
+            for wid in wids:
+                row = {"worker": wid}
+                for name, sets in (("chain", chains), ("best", bests)):
+                    if wid not in sets:
+                        continue
+                    s = sets[wid]
+                    row[name + "_gates"] = len(s) + len(outputs)
+                    if seeds:
+                        row[name + "_seed"] = round(min(self._jd(s, x) for x in seeds), 4)
+                    others = [self._jd(s, sets[o]) for o in sets if o != wid]
+                    if others:
+                        row[name + "_peer"] = round(min(others), 4)
+                rows.append(row)
+            summary = {}
+            for name, sets in (("chains", chains), ("bests", bests)):
+                ds = [self._jd(sets[a], sets[b]) for i, a in enumerate(sets) for b in list(sets)[i + 1:]]
+                if ds:
+                    summary[name] = {"mean": round(sum(ds) / len(ds), 4), "min": round(min(ds), 4),
+                                     "max": round(max(ds), 4), "pairs": len(ds)}
+            self.log.write("group_watch", group=group, target=key, workers=rows, **summary)
+            with open(self.run_dir / "watch" / f"{group}.jsonl", "a", encoding="utf-8") as fh:
+                stamp = utc_now()
+                for wid in wids:
+                    data = raw[wid]
+                    fh.write(json.dumps({"utc": stamp, "worker": wid, "t": data.get("t"),
+                                         "steps": data.get("steps"), "chain": data.get("chain_values"),
+                                         "best": data.get("best_values")}, separators=(",", ":")) + "\n")
+
 
